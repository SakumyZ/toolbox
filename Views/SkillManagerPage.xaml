<Page
    x:Class="ToolBox.Views.SkillManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:ToolBox.Views"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <Grid Padding="24,20,24,16" RowDefinitions="Auto,Auto,*">
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="Skill 管理器" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Name="CountText" Text="" Style="{StaticResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="StatusMessage" Text="" Style="{StaticResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Click="CategoryManager_Click" Padding="10,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE81E;" FontSize="12" />
                        <TextBlock Text="分类管理" />
                    </StackPanel>
                </Button>
                <Button Click="ArchiveManager_Click" Padding="10,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE7B8;" FontSize="12" />
                        <TextBlock Text="归档管理" />
                    </StackPanel>
                </Button>
                <Button Click="AdvancedSettings_Click" Padding="10,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE713;" FontSize="12" />
                        <TextBlock Text="高级设置" />
                    </StackPanel>
                </Button>
                <Button Click="Refresh_Click" ToolTipService.ToolTip="刷新" Padding="8,6">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" RowDefinitions="Auto" Margin="0,0,0,12">
            <Grid Margin="0,0,0,0" ColumnDefinitions="280,140,140,*">
                <AutoSuggestBox x:Name="SearchBox" PlaceholderText="搜索 skill 名称、别名或描述..."
                                QueryIcon="Find" TextChanged="SearchBox_TextChanged" />
                <ComboBox x:Name="CategoryFilter" Grid.Column="1" Margin="12,0,0,0"
                          SelectionChanged="Filter_Changed" />
                <ComboBox x:Name="StateFilter" Grid.Column="2" Margin="12,0,0,0"
                          SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="全部状态" IsSelected="True" />
                    <ComboBoxItem Content="已启用" Tag="Active" />
                    <ComboBoxItem Content="已停用" Tag="Inactive" />
                </ComboBox>
            </Grid>
        </Grid>

        <Grid Grid.Row="2">
            <ListView x:Name="SkillList" SelectionMode="None" Padding="0"
                      Background="Transparent" BorderThickness="0">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0,0,0,8" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="14,8"
                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                              BorderThickness="1"
                              CornerRadius="8"
                              ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Border Background="{Binding CategoryBackgroundBrush}"
                                            CornerRadius="4"
                                            Padding="6,1"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Category}" FontSize="11" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center" Margin="12,0,0,0">
                                <Button Click="EditSkill_Click" Tag="{Binding SkillId}" Padding="8,4" MinHeight="28" VerticalAlignment="Center" Background="Transparent" BorderThickness="0">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE70F;" FontSize="12" />
                                        <TextBlock Text="编辑" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <ToggleSwitch OnContent="开启"
                                              OffContent="关闭"
                                              IsOn="{Binding IsActive}"
                                              Tag="{Binding SkillId}"
                                              Toggled="SkillToggle_Toggled" 
                                              Margin="0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ProgressRing x:Name="LoadingRing" IsActive="False"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Width="40" Height="40" />
        </Grid>

        <ContentDialog x:Name="AdvancedSettingsDialog" Title="高级设置" PrimaryButtonText="保存" CloseButtonText="取消" PrimaryButtonClick="AdvancedSettingsDialog_PrimaryButtonClick">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="500">
                <StackPanel Spacing="16" Width="480">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Skill 启用目录" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox x:Name="DialogActivePathBox" PlaceholderText="例如：%USERPROFILE%\.agents\skills" />
                            <Button Grid.Column="1" Margin="8,0,0,0" Content="浏览..." Click="BrowseActivePath_Click" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <TextBlock Text="Skill 停用目录" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox x:Name="DialogInactivePathBox" PlaceholderText="例如：D:\Backup\AI\skills" />
                            <Button Grid.Column="1" Margin="8,0,0,0" Content="浏览..." Click="BrowseInactivePath_Click" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <TextBlock Text="Agent 软链接分发目录" FontWeight="SemiBold" />
                        <ListView x:Name="AgentDirsList" SelectionMode="None" ItemsSource="{x:Bind AgentDirsCollection, Mode=OneWay}" 
                                  MaxHeight="240" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:AgentDirItem">
                                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
                                        <TextBox Text="{x:Bind Path, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Agent skill 目录绝对路径" />
                                        <Button Grid.Column="1" Margin="8,0,0,0" Content="浏览..." Click="BrowseAgentDir_Click" Tag="{x:Bind}" />
                                        <Button Grid.Column="2" Margin="8,0,0,0" Click="RemoveAgentDir_Click" Tag="{x:Bind}">
                                            <FontIcon Glyph="&#xE107;" FontSize="12" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Button Content="添加目录" Click="AddAgentDir_Click" HorizontalAlignment="Left" />
                        <TextBlock Text="关闭 skill 时会将文件夹移入停用目录，并删除各 Agent 目录下的软链接；重新开启时移回启用目录，并同步生成软链接。"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>

        <ContentDialog x:Name="ArchiveManagerDialog" Title="归档管理" CloseButtonText="关闭">
            <Grid Width="500" MinHeight="300">
                <ListView x:Name="ArchivedSkillList" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8" ColumnDefinitions="*,Auto,Auto">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Category}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Button Grid.Column="1" Click="UnarchiveSkill_Click" Tag="{Binding SkillId}" Margin="8,0" Content="取消归档" />
                                <Button Grid.Column="2" Content="彻底删除" Foreground="White" BorderThickness="0">
                                    <Button.Resources>
                                        <SolidColorBrush x:Key="ButtonBackground" Color="#D13438" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FF99A4" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#C62828" />
                                    </Button.Resources>
                                    <Button.Flyout>
                                        <Flyout>
                                            <StackPanel Spacing="12" MinWidth="200">
                                                <TextBlock Text="确定要彻底删除吗？此操作不可恢复。" TextWrapping="Wrap" />
                                                <Button Content="确认删除" Background="#D13438" Foreground="White" BorderThickness="0" Click="ConfirmDeleteArchivedSkill_Click" Tag="{Binding SkillId}" HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="EmptyArchiveText" Text="暂无归档内容" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
            </Grid>
        </ContentDialog>

        <ContentDialog x:Name="CategoryManagerDialog" Title="分类管理" CloseButtonText="关闭">
            <Grid Width="500" MinHeight="300">
                <ListView x:Name="CategoryList" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8" ColumnDefinitions="Auto,*,Auto,Auto">
                                <Border Grid.Column="0" Width="16" Height="16" CornerRadius="4" VerticalAlignment="Center" Margin="0,0,12,0" Background="{Binding BackgroundBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" />
                                <TextBlock Grid.Column="1" Text="{Binding CategoryName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Margin="8,0" Content="重命名">
                                    <Button.Flyout>
                                        <Flyout>
                                            <StackPanel Spacing="12" MinWidth="250">
                                                <TextBlock Text="重命名分类" FontWeight="SemiBold" />
                                                <TextBox Text="{Binding CategoryName, Mode=OneWay}" PlaceholderText="新分类名称" />
                                                <Button Content="确定" Click="ConfirmRenameCategory_Click" Tag="{Binding CategoryName}" HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <Button Grid.Column="3" Content="删除" Foreground="White" BorderThickness="0">
                                    <Button.Resources>
                                        <SolidColorBrush x:Key="ButtonBackground" Color="#D13438" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FF99A4" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#C62828" />
                                    </Button.Resources>
                                    <Button.Flyout>
                                        <Flyout>
                                            <StackPanel Spacing="12" MinWidth="200">
                                                <TextBlock Text="确定要删除吗？相关 Skill 将置为未分类。" TextWrapping="Wrap" />
                                                <Button Content="确认删除" Background="#D13438" Foreground="White" BorderThickness="0" Click="ConfirmDeleteCategory_Click" Tag="{Binding CategoryName}" HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="EmptyCategoryText" Text="暂无分类" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
            </Grid>
        </ContentDialog>
    </Grid>
</Page>