<Page
    x:Class="ToolBox.Views.ContextMenuManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ToolBox.Models"
    xmlns:local="using:ToolBox.Views"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <Grid Padding="24,20,24,16" RowDefinitions="Auto,Auto,Auto,*">
        <!-- 头部标题栏 -->
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="右键菜单管理" Style="{StaticResource TitleTextBlockStyle}" IsTextSelectionEnabled="True" />
                <TextBlock x:Name="CountText" Text="" Style="{StaticResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Click="AddCustom_Click" Padding="10,6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                    <TextBlock Text="新增自定义右键" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- 权限状态提示 Banner -->
        <InfoBar Grid.Row="1" x:Name="AdminInfoBar" 
                 Title="权限状态" 
                 Message="正在加载权限状态..." 
                 IsOpen="True" 
                 IsClosable="False" 
                 Margin="0,0,0,16">
            <InfoBar.ActionButton>
                <Button x:Name="ElevateButton" Content="以管理员身份运行" Click="ElevateButton_Click" Visibility="Collapsed" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- 右键菜单风格一键切换卡片 -->
        <Border Grid.Row="2" Margin="0,0,0,16" Padding="16,12" CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                Visibility="Collapsed" x:Name="StyleSettingsCard">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Windows 11 经典右键菜单样式 (Win10 风格)" Style="{StaticResource BodyStrongTextBlockStyle}" IsTextSelectionEnabled="True" />
                    <TextBlock Text="开启后，所有右键菜单都会展示在最外面的第一级，无需点击“显示更多选项”。设置后将自动重启资源管理器。" 
                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" x:Name="ClassicStyleToggle" IsOn="False" Toggled="ClassicStyleToggle_Toggled" 
                              OnContent="已开启" OffContent="已关闭" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- 核心内容页签 -->
        <Pivot Grid.Row="3" x:Name="ScopePivot" SelectionChanged="ScopePivot_SelectionChanged" Margin="0,-8,0,0">
            <PivotItem Header="文件右键菜单">
                <ListView x:Name="FileList" Margin="0,8,0,0" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ContextMenuItem">
                            <Grid Padding="0,8" ColumnDefinitions="Auto,*,Auto,Auto">
                                <Grid Margin="0,0,16,0" Width="24" Height="24" VerticalAlignment="Center">
                                    <Image Source="{x:Bind IconImage, Mode=OneWay}" Width="20" Height="20"
                                           Visibility="{x:Bind local:ContextMenuManagerPage.BoolToVisibility(HasIcon), Mode=OneWay}" />
                                    <FontIcon Glyph="&#xE7AC;" FontSize="20"
                                              Visibility="{x:Bind local:ContextMenuManagerPage.BoolToInverseVisibility(HasIcon), Mode=OneWay}"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </Grid>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" IsTextSelectionEnabled="True" />
                                        <Border Background="{x:Bind local:ContextMenuManagerPage.GetLevelBrush(IsShellExtension), Mode=OneWay}" CornerRadius="4" Padding="6,1">
                                            <TextBlock Text="{x:Bind local:ContextMenuManagerPage.GetLevelText(IsShellExtension), Mode=OneWay}" FontSize="10" Foreground="White" />
                                        </Border>
                                        <Border Visibility="{x:Bind local:ContextMenuManagerPage.BoolToVisibility(IsCustom)}" Background="{ThemeResource SystemFillColorSuccessBrush}" CornerRadius="4" Padding="6,1">
                                            <TextBlock Text="自定义" FontSize="10" Foreground="White" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind RegistryPath}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" IsTextSelectionEnabled="True" />
                                    <TextBlock Text="{x:Bind Command}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="2" IsOn="{x:Bind IsActive, Mode=OneWay}" Toggled="ActiveToggle_Toggled" IsEnabled="{x:Bind IsWritable}" OffContent="已禁用" OnContent="已启用" VerticalAlignment="Center" Margin="16,0" />
                                <Button Grid.Column="3" Click="DeleteCustom_Click" Visibility="{x:Bind local:ContextMenuManagerPage.BoolToVisibility(IsCustom)}" IsEnabled="{x:Bind IsWritable}" Content="删除" Background="Transparent" Foreground="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </PivotItem>
            
            <PivotItem Header="文件夹右键菜单">
                <ListView x:Name="DirectoryList" Margin="0,8,0,0" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ContextMenuItem">
                            <Grid Padding="0,8" ColumnDefinitions="Auto,*,Auto,Auto">
                                <Grid Margin="0,0,16,0" Width="24" Height="24" VerticalAlignment="Center">
                                    <Image Source="{x:Bind IconImage, Mode=OneWay}" Width="20" Height="20"
                                           Visibility="{x:Bind local:ContextMenuManagerPage.BoolToVisibility(HasIcon), Mode=OneWay}" />
                                    <FontIcon Glyph="&#xE8B7;" FontSize="20"
                                              Visibility="{x:Bind local:ContextMenuManagerPage.BoolToInverseVisibility(HasIcon), Mode=OneWay}"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </Grid>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" IsTextSelectionEnabled="True" />
                                        <Border Background="{x:Bind local:ContextMenuManagerPage.GetLevelBrush(IsShellExtension), Mode=OneWay}" CornerRadius="4" Padding="6,1">
                                            <TextBlock Text="{x:Bind local:ContextMenuManagerPage.GetLevelText(IsShellExtension), Mode=OneWay}" FontSize="10" Foreground="White" />
                                        </Border>
                                        <Border Visibility="{x:Bind local:ContextMenuManagerPage.BoolToVisibility(IsCustom)}" Background="{ThemeResource SystemFillColorSuccessBrush}" CornerRadius="4" Padding="6,1">
                                            <TextBlock Text="自定义" FontSize="10" Foreground="White" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind RegistryPath}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" IsTextSelectionEnabled="True" />
                                    <TextBlock Text="{x:Bind Command}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="2" IsOn="{x:Bind IsActive, Mode=OneWay}" Toggled="ActiveToggle_Toggled" IsEnabled="{x:Bind IsWritable}" OffContent="已禁用" OnContent="已启用" VerticalAlignment="Center" Margin="16,0" />
                                <Button Grid.Column="3" Click="DeleteCustom_Click" Visibility="{x:Bind local:ContextMenuManagerPage.BoolToVisibility(IsCustom)}" IsEnabled="{x:Bind IsWritable}" Content="删除" Background="Transparent" Foreground="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </PivotItem>

            <PivotItem Header="空白背景右键菜单">
                <ListView x:Name="BackgroundList" Margin="0,8,0,0" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ContextMenuItem">
                            <Grid Padding="0,8" ColumnDefinitions="Auto,*,Auto,Auto">
                                <Grid Margin="0,0,16,0" Width="24" Height="24" VerticalAlignment="Center">
                                    <Image Source="{x:Bind IconImage, Mode=OneWay}" Width="20" Height="20"
                                           Visibility="{x:Bind local:ContextMenuManagerPage.BoolToVisibility(HasIcon), Mode=OneWay}" />
                                    <FontIcon Glyph="&#xE7F4;" FontSize="20"
                                              Visibility="{x:Bind local:ContextMenuManagerPage.BoolToInverseVisibility(HasIcon), Mode=OneWay}"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </Grid>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" IsTextSelectionEnabled="True" />
                                        <Border Background="{x:Bind local:ContextMenuManagerPage.GetLevelBrush(IsShellExtension), Mode=OneWay}" CornerRadius="4" Padding="6,1">
                                            <TextBlock Text="{x:Bind local:ContextMenuManagerPage.GetLevelText(IsShellExtension), Mode=OneWay}" FontSize="10" Foreground="White" />
                                        </Border>
                                        <Border Visibility="{x:Bind local:ContextMenuManagerPage.BoolToVisibility(IsCustom)}" Background="{ThemeResource SystemFillColorSuccessBrush}" CornerRadius="4" Padding="6,1">
                                            <TextBlock Text="自定义" FontSize="10" Foreground="White" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind RegistryPath}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" IsTextSelectionEnabled="True" />
                                    <TextBlock Text="{x:Bind Command}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="2" IsOn="{x:Bind IsActive, Mode=OneWay}" Toggled="ActiveToggle_Toggled" IsEnabled="{x:Bind IsWritable}" OffContent="已禁用" OnContent="已启用" VerticalAlignment="Center" Margin="16,0" />
                                <Button Grid.Column="3" Click="DeleteCustom_Click" Visibility="{x:Bind local:ContextMenuManagerPage.BoolToVisibility(IsCustom)}" IsEnabled="{x:Bind IsWritable}" Content="删除" Background="Transparent" Foreground="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
