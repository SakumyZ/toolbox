<ContentDialog
    x:Class="ToolBox.Views.BackupDataManagerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    DefaultButton="None"
    Loaded="ContentDialog_Loaded">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">900</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">900</x:Double>
        <x:Double x:Key="ContentDialogMinHeight">600</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">600</x:Double>
    </ContentDialog.Resources>

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" RowDefinitions="Auto,*,Auto">
        <!-- 顶部标题和右上角关闭按钮 -->
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <TextBlock Text="备份数据管理" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" FontWeight="SemiBold" />
            <Button Grid.Column="1" Click="Close_Click" Background="Transparent" BorderThickness="0" Padding="8,6" VerticalAlignment="Center" HorizontalAlignment="Right">
                <FontIcon Glyph="&#xE711;" FontSize="14" />
            </Button>
        </Grid>

        <!-- 中间表格区域 -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*">
            <!-- 表头 -->
            <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1,1,1,0"
                  CornerRadius="4,4,0,0"
                  Padding="8,6" 
                  ColumnDefinitions="40,*,180,100,80">
                <CheckBox x:Name="SelectAllCheckBox" Checked="SelectAllCheckBox_Checked" Unchecked="SelectAllCheckBox_Unchecked" MinWidth="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="文件名" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="修改时间" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="大小" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="操作" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <!-- 列表、空数据及加载提示 -->
            <Grid Grid.Row="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,1,1" CornerRadius="0,0,4,4">
                <!-- 列表 -->
                <ListView x:Name="BackupListView" SelectionMode="None" Padding="0">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8,8" ColumnDefinitions="40,*,180,100,80" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Checked="ItemCheckBox_CheckedChanged" Unchecked="ItemCheckBox_CheckedChanged" MinWidth="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Grid.Column="2" Text="{Binding DisplayTime}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Grid.Column="3" Text="{Binding DisplaySize}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Button Grid.Column="4" Content="恢复" Click="RestoreItem_Click" Style="{StaticResource AccentButtonStyle}" Padding="12,4" HorizontalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- 暂无数据提示 -->
                <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16" Visibility="Collapsed">
                    <Viewbox Height="64" Width="64">
                        <Canvas Height="32" Width="32">
                            <!-- 立方体箱子底座 -->
                            <Path Data="M 16 2 L 2 9 L 16 16 L 30 9 Z" Fill="{ThemeResource SystemControlBackgroundChromeMediumBrush}" />
                            <Path Data="M 2 11 L 16 18 L 16 30 L 2 23 Z" Fill="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" />
                            <Path Data="M 30 11 L 16 18 L 16 30 L 30 23 Z" Fill="{ThemeResource SystemControlBackgroundListLowBrush}" />
                            <!-- 绿点 -->
                            <Ellipse Canvas.Left="13" Canvas.Top="6" Width="6" Height="4" Fill="#FF107C41" />
                            <Ellipse Canvas.Left="7" Canvas.Top="11" Width="4" Height="4" Fill="#FF107C41" />
                            <Ellipse Canvas.Left="21" Canvas.Top="11" Width="4" Height="4" Fill="#FF107C41" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="暂无数据" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="14" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- 加载中提示 -->
                <ProgressRing x:Name="LoadingRing" IsActive="True" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>
        </Grid>

        <!-- 底部按钮 -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8" Margin="0,16,0,0">
            <Button Click="Refresh_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72C;" FontSize="12" />
                    <TextBlock Text="刷新" />
                </StackPanel>
            </Button>
            <Button Grid.Column="1" x:Name="DeleteSelectedButton" Click="DeleteSelected_Click" IsEnabled="False">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE74D;" FontSize="12" />
                    <TextBlock x:Name="DeleteButtonText" Text="删除选中 (0)" />
                </StackPanel>
            </Button>
            <Button Grid.Column="3" Content="关闭" Click="Close_Click" Width="80"/>
        </Grid>
    </Grid>
</ContentDialog>
