<Window
    x:Class="ToolBox.Views.NotificationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="通知">
    <Grid
        x:Name="NotificationRoot"
        Background="Transparent"
        PointerEntered="NotificationRoot_PointerEntered"
        PointerExited="NotificationRoot_PointerExited">
        <Border
            x:Name="RootBorder"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="Transparent"
            BorderThickness="0"
            CornerRadius="0">
            <Grid ColumnDefinitions="96,*">
                <Border
                    Grid.Column="0"
                    x:Name="ImageColumnBorder"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="0">
                    <Grid>
                        <Border x:Name="ImageOverlay" Background="#22000000" />
                        <Image
                            x:Name="PreviewImage"
                            Margin="12"
                            Stretch="Uniform" />
                    </Grid>
                </Border>
                <Grid Grid.Column="1" Padding="12,10,10,8" RowDefinitions="Auto,*,Auto">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock
                            x:Name="TitleText"
                            FontSize="15"
                            FontWeight="SemiBold"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis" />
                        <Button
                            Grid.Column="1"
                            Width="24"
                            Height="24"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="CloseButton_Click">
                            <FontIcon Glyph="&#xE711;" FontSize="10" />
                        </Button>
                    </Grid>
                    <TextBlock
                        x:Name="MessageText"
                        Grid.Row="1"
                        Margin="0,4,0,6"
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MaxLines="2"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        x:Name="FooterText"
                        Grid.Row="2"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>