<Page
    x:Class="ToolBox.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Page_Loaded">
    <Grid Padding="24,20,24,16" RowDefinitions="Auto,*">
        <!-- 标题 -->
        <TextBlock Text="设置" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,12" />
        <!-- 设置内容 -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="20">
                <!-- 通知设置卡片 -->
                <Grid Padding="16,14" CornerRadius="8"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                    <TextBlock Text="通知样式设置" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,12" />
                    <!-- 显示样式 -->
                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,0,0,16">
                        <TextBlock Text="显示样式" VerticalAlignment="Center" MinWidth="100" />
                        <ComboBox x:Name="DisplayStyleBox" Grid.Column="1" SelectedIndex="0"
                                  SelectionChanged="DisplayStyleBox_SelectionChanged">
                            <ComboBoxItem Tag="0">标准</ComboBoxItem>
                            <ComboBoxItem Tag="1">紧凑</ComboBoxItem>
                        </ComboBox>
                    </Grid>
                    <!-- 颜色主题 -->
                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*" Margin="0,0,0,16">
                        <TextBlock Text="颜色主题" VerticalAlignment="Center" MinWidth="100" />
                        <ComboBox x:Name="ColorThemeBox" Grid.Column="1" SelectedIndex="0"
                                  SelectionChanged="ColorThemeBox_SelectionChanged">
                            <ComboBoxItem Tag="0">系统</ComboBoxItem>
                            <ComboBoxItem Tag="1">浅色</ComboBoxItem>
                            <ComboBoxItem Tag="2">深色</ComboBoxItem>
                        </ComboBox>
                    </Grid>
                    <!-- 自动关闭时长 -->
                    <Grid Grid.Row="3" ColumnDefinitions="Auto,*" Margin="0,0,0,16">
                        <TextBlock Text="自动关闭时长（毫秒）" VerticalAlignment="Center" MinWidth="100" />
                        <NumberBox x:Name="AutoCloseMillisecondsBox" Grid.Column="1" Value="6000"
                                   Minimum="100" Maximum="600000"
                                   SpinButtonPlacementMode="Compact"
                                   LargeChange="1000" SmallChange="100"
                                   ValueChanged="AutoCloseMillisecondsBox_ValueChanged" />
                    </Grid>
                    <!-- 操作按钮 -->
                    <Grid Grid.Row="4" ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                        <Button Click="Preview_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE890;" FontSize="12" />
                                <TextBlock Text="预览通知" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Click="SaveSettings_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74E;" FontSize="12" />
                                <TextBlock Text="保存" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Grid.Row="5" Margin="0,12,0,0"
                               Text="提示：预览通知会按当前设置显示一条样本通知，3 秒后自动关闭。"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>